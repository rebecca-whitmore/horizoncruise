# WordPress REST API base URL, without a trailing slash.
WORDPRESS_API_URL=

# Public website origin, without a trailing slash.
SITE_URL=

# Set to true only when the finished production site should enter search results.
SITE_INDEXABLE=false

# Widgety API settings. Keep the real APP ID and token in .env.local only.
WIDGETY_API_URL=
WIDGETY_APP_ID=
WIDGETY_API_TOKEN=
